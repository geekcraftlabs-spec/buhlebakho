generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model ProductVariant {
  id               String   @id @default(cuid())
  hairType         String   // "human-blend" | "futura-fibre" | "custom-human-hair"
  laceType         String   // "5x5" | "13x4" | "13x6"
  texture          String   // "bone-straight" | "body-wave" | "deep-wave"
  colorCode        String   // "1B", "27", etc.
  colorName        String
  sizeGroup        String?  // "10-14" | "16-20" | "22-30"
  futuraSize       String?  // "short" | "long"
  sizeLabel        String   // "14" or "short" or "long"
  price            Int
  salePrice        Int?
  stockCount       Int      @default(0)
  image            String
  isHidden         Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  slotCount        Int?
  slotPeriodStart  DateTime?
  slotPeriodEnd    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  waitlistEntries  WaitlistEntry[]
  inventoryLogs    InventoryLogEntry[]

  @@unique([hairType, laceType, texture, colorCode, sizeLabel])
  @@index([hairType])
  @@index([isFeatured])
  @@index([isHidden])
}

model Order {
  id               String   @id
  name             String
  whatsapp         String
  email            String?
  deliveryMethod   String   @default("door")
  address          String?
  smsNumber        String?
  items            Json
  subtotal         Int
  deliveryFee      Int
  total            Int
  status           String   @default("pending")
  paidAt           DateTime?
  orderDay         String?
  yocoCheckoutId   String?
  yocoPaymentId    String?
  waybill          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([orderDay])
  @@index([createdAt])
  @@index([paidAt])
}

model WaitlistEntry {
  id                String         @id @default(cuid())
  phone             String
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantSnapshot   Json
  notified          Boolean        @default(false)
  notifiedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([variantId])
  @@index([notified])
}

model InventoryLogEntry {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  action       String
  beforeValue  String?
  afterValue   String?
  reason       String?
  createdAt    DateTime       @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}