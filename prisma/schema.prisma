generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model ProductVariant {
  id         String   @id @default(cuid())
  hairType   String
  texture    String
  laceType   String
  colorCode  String
  colorName  String
  sizeLabel  String
  price      Int
  salePrice  Int?
  stockCount Int      @default(0)
  image      String
  isHidden   Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hairType, laceType, texture, colorCode, sizeLabel])
  @@index([hairType])
  @@index([isFeatured])
  @@index([isHidden])
}

model Order {
  id             String    @id
  name           String
  whatsapp       String
  email          String?
  deliveryMethod String    @default("door")
  address        String?
  smsNumber      String?
  items          Json
  subtotal       Int
  deliveryFee    Int
  total          Int
  status         String    @default("pending")
  paidAt         DateTime?
  orderDay       String?
  yocoCheckoutId String?
  yocoPaymentId  String?
  waybill        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([orderDay])
  @@index([createdAt])
  @@index([paidAt])
}

model WaitlistEntry {
  id              String   @id @default(cuid())
  phone           String
  variantId       String
  variantSnapshot Json
  notified        Boolean  @default(false)
  notifiedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([variantId])
  @@index([notified])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}